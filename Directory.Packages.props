<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Which PhoenixmlDb engine train this release of crucible targets.
         Declared here, next to the pins it governs, because crucible is a CONSUMER of the
         engine train and not a member of it: crucible versions on its own 1.1.x line, so
         "pin == this repo's release version" — the rule the engine repos use — can never hold
         here. check-release-train.sh compares the train-locked pins against THIS value. -->
    <EngineTrain>2.1.0</EngineTrain>
  </PropertyGroup>
  <ItemGroup>
    <!-- PhoenixmlDb. check-pins: train-locked — must equal the release version at pack time.
         crucible.cli EMBEDS this engine (PackAsTool ships the full publish output) and crucible
         builds phoenixml.dev, so this pin decides which engine renders our own documentation.

         It sat at 1.6.13 — the one version recorded as known-bad, which ships depending on
         XQuery 1.6.12 (phoenixmldb-xslt docs/RELEASE-HYGIENE.md, Tier 1) — and nothing noticed,
         because this repo had no pin check of any kind. It has two now: check-pins.sh catches a
         pin behind what is published, check-release-train.sh catches one behind the train being
         released. Bumping it is train work and is deliberately not done in the same change that
         adds the checks. -->
    <PackageVersion Include="PhoenixmlDb.Xslt" Version="2.1.0" />
    <!-- Markdown/YAML -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Intentionally pinned. 7.x/8.x moved to the Xceed license (paid for commercial
         use); 6.12.2 is the last MIT release. Do not bump without a licensing decision. -->
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
  </ItemGroup>
</Project>
