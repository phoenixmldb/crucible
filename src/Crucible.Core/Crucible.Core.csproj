<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Crucible.Core</RootNamespace>
    <Description>Pipeline engine for the Crucible static documentation generator</Description>
    <PackageTags>documentation;markdown;xslt;static-site;xml</PackageTags>

    <!-- Not published. This assembly ships inside the crucible.cli tool package,
         which PackAsTool builds from the full publish output. Publishing it as a
         standalone library would also mean shipping Themes/ as package content
         and supporting it as a public API surface; nothing consumes it that way
         today. See the NuGet section of RELEASES.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="PhoenixmlDb.Xslt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Theme assets ship next to the assembly, because ThemeLoader resolves
         built-in themes from AppContext.BaseDirectory. Copying to the output
         directory is enough: the crucible.cli tool package is built from the
         publish output, so Themes/ flows into it from here.

         Exclude the C# sources that live in this folder (ThemeLoader.cs) — the
         glob would otherwise copy them to the output directory and into the
         published tool. Maintainer docs are excluded for the same reason. -->
    <None Include="Themes/**/*"
          Exclude="Themes/**/*.cs;Themes/**/*.md"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
