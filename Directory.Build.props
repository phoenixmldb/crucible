<Project>
  <PropertyGroup>
    <!-- net10.0 always; net11.0 whenever the SDK can build it. global.json pins SDK 11, so a
         normal build produces both. CI's build-sdk10 job builds with SDK 10, which yields
         net10.0 alone and proves the net10.0 build does not depend on SDK 11. SDK 10 leaves
         NETCoreSdkVersion empty this early, which therefore reads as "not 11". -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(NETCoreSdkVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>
  <!-- .NET 11 gives string's char methods (StartsWith, EndsWith, IndexOf, LastIndexOf) a
       StringComparison overload, so CA1307 starts to report every char call in the net11.0
       build. A char comparison is ordinal; there is no culture to make explicit. The same
       sources are analyzed for net10.0, where CA1307 still checks the string overloads that
       do take a culture. Remove this when net10.0 is no longer a target. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <NoWarn>$(NoWarn);CA1307</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Endpoint Systems</Authors>
    <Company>Endpoint Systems</Company>
    <Product>Crucible</Product>
    <Copyright>Copyright © Endpoint Systems 2026. All rights reserved.</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/phoenixmldb/crucible</RepositoryUrl>
    <PackageProjectUrl>https://phoenixml.dev</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)PACKAGE.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Test projects run on Microsoft.Testing.Platform (see global.json). Keyed on the project
       name because IsTestProject is not yet defined when this file is evaluated. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
