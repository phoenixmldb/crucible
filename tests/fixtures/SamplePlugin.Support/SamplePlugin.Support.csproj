<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A dependency of the sample plugin, and nothing else. Its only job is to exist
    outside the test host's own probing path, so that resolving it proves the plugin
    loader's dependency resolution actually works.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
  </PropertyGroup>

</Project>
